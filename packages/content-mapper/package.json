{
  "name": "@ftslang/content-mapper",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "TypeScript content mapper and proposal lowering for FTS",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.cjs"
    },
    "./mapper": "./dist/mapper.cjs",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "build": "wireit",
    "build:types": "wireit",
    "check": "tsc",
    "test": "vitest run --project unit",
    "test:integration": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:runtime",
        "build:types"
      ]
    },
    "build:runtime": {
      "command": "esbuild src/index.ts --bundle --packages=external --platform=node --target=node24 --format=cjs --outfile=dist/index.cjs --sourcemap && esbuild src/mapper.ts --bundle --packages=external --platform=node --target=node24 --format=cjs --outfile=dist/mapper.cjs --sourcemap",
      "files": [
        "../../tsconfig.base.json",
        "package.json",
        "src/**/*.ts",
        "tsconfig*.json"
      ],
      "output": [
        "dist/*.cjs",
        "dist/*.cjs.map"
      ]
    },
    "build:types": {
      "command": "tsc -p tsconfig.build.json",
      "files": [
        "../../tsconfig.base.json",
        "package.json",
        "src/**/*.ts",
        "tsconfig*.json"
      ],
      "output": [
        "dist/**/*.d.ts"
      ]
    },
    "test:integration": {
      "command": "vitest run --project integration",
      "dependencies": [
        "build"
      ]
    }
  },
  "dependencies": {
    "@babel/core": "8.0.1",
    "@babel/plugin-proposal-pipeline-operator": "8.0.1",
    "@jridgewell/trace-mapping": "0.3.31",
    "typescript": "7.1.0-beta",
    "vscode-jsonrpc": "10.0.0"
  },
  "devDependencies": {
    "@types/babel__core": "7.20.5"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "dist/mapper.cjs"
      ],
      "compilerOptions": [],
      "dynamicConfig": false
    }
  },
  "files": [
    "dist"
  ]
}
