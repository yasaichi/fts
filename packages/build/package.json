{
  "name": "@ftslang/build",
  "description": "Build integrations for fts",
  "version": "0.0.1",
  "dependencies": {
    "@ftslang/content-mapper": "0.0.1",
    "@jridgewell/remapping": "2.3.5",
    "@swc/core": "1.16.22",
    "unplugin": "3.7.0"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "0.3.31",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.11"
  },
  "exports": {
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "private": true,
  "scripts": {
    "build": "wireit",
    "build:runtime": "wireit",
    "build:types": "wireit",
    "check": "tsc",
    "test": "wireit"
  },
  "type": "module",
  "wireit": {
    "build": {
      "dependencies": [
        "../content-mapper:build",
        "build:runtime",
        "build:types"
      ]
    },
    "build:runtime": {
      "command": "esbuild src/vite.ts --bundle --packages=external --external:@ftslang/content-mapper --platform=node --target=node24 --format=esm --outfile=dist/vite.mjs --sourcemap",
      "files": [
        "../../tsconfig.base.json",
        "package.json",
        "src/**/*.ts",
        "tsconfig*.json"
      ],
      "output": [
        "dist/*.mjs",
        "dist/*.mjs.map"
      ]
    },
    "build:types": {
      "command": "tsc -p tsconfig.build.json",
      "files": [
        "../../tsconfig.base.json",
        "package.json",
        "src/**/*.ts",
        "tsconfig*.json"
      ],
      "output": [
        "dist/**/*.d.ts"
      ],
      "dependencies": [
        "../content-mapper:build:types"
      ]
    },
    "test": {
      "command": "vitest run --exclude \"test/fixtures/**\"",
      "dependencies": [
        "build"
      ]
    }
  }
}
