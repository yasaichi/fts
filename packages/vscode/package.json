{
  "name": "ftslang-vscode",
  "description": "FTS grammar and TypeScript content mapper registration",
  "version": "0.0.1",
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "future-typescript",
        "aliases": [
          "Future TypeScript",
          "fts"
        ],
        "extensions": [
          ".fts"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "future-typescript",
        "scopeName": "source.fts",
        "path": "./syntaxes/fts.tmLanguage.json"
      }
    ]
  },
  "dependencies": {
    "@ftslang/content-mapper": "0.0.1"
  },
  "devDependencies": {
    "@types/vscode": "1.145.0"
  },
  "displayName": "Future TypeScript",
  "engines": {
    "node": ">=24.11",
    "vscode": "^1.132.0"
  },
  "main": "./dist/extension.cjs",
  "private": true,
  "scripts": {
    "build": "wireit",
    "check": "tsc",
    "test": "wireit"
  },
  "type": "module",
  "wireit": {
    "build": {
      "command": "esbuild src/extension.ts --bundle --packages=external --platform=node --target=node24 --format=cjs --external:vscode --outfile=dist/extension.cjs --sourcemap",
      "files": [
        "../../tsconfig.base.json",
        "package.json",
        "src/**/*.ts",
        "tsconfig*.json"
      ],
      "output": [
        "dist/**"
      ],
      "dependencies": [
        "../content-mapper:build"
      ]
    },
    "test": {
      "command": "vitest run",
      "dependencies": [
        "../content-mapper:build"
      ]
    }
  }
}
