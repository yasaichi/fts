{
  "name": "@ftslang/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Language Server Protocol implementation for fts",
  "main": "./dist/server.cjs",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.cjs"
    },
    "./check": {
      "types": "./dist/check.d.ts",
      "default": "./dist/check.cjs"
    }
  },
  "bin": {
    "fts-language-server": "./bin/fts-language-server.cjs"
  },
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "build": "npm run build:types && npm run build:runtime",
    "build:runtime": "esbuild src/server.ts src/check.ts --bundle --packages=external --external:@ftslang/core --platform=node --target=node24 --format=cjs --outdir=dist --out-extension:.js=.cjs --sourcemap",
    "build:types": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "npm run build -w @ftslang/core && npm run build -w @ftslang/server && vitest run"
  },
  "dependencies": {
    "@ftslang/core": "0.0.1",
    "@volar/kit": "2.4.28",
    "@volar/language-server": "2.4.28",
    "tinyglobby": "0.2.17",
    "typescript": "6.0.3",
    "volar-service-typescript": "0.0.71"
  },
  "devDependencies": {
    "@volar/test-utils": "2.4.28"
  }
}
