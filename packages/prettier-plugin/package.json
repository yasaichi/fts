{
  "name": "@ftslang/prettier-plugin",
  "description": "Prettier language support for fts",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.11"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "peerDependencies": {
    "prettier": "3.9.10"
  },
  "private": true,
  "scripts": {
    "build": "wireit",
    "check": "tsc",
    "test": "vitest run"
  },
  "type": "module",
  "wireit": {
    "build": {
      "command": "tsc -p tsconfig.build.json",
      "files": [
        "../../tsconfig.base.json",
        "package.json",
        "src/**/*.ts",
        "tsconfig*.json"
      ],
      "output": [
        "dist/**"
      ]
    }
  }
}
