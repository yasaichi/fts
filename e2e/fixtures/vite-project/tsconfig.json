{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"]
  },
  "contentMappers": [
    {
      "package": "@ftslang/content-mapper",
      "extensions": [".fts"]
    }
  ],
  "include": ["scripts", "src", "test", "vite.config.ts"]
}
