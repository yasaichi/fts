{
  "name": "fts",
  "version": "0.0.1",
  "private": true,
  "description": "Proposal-aware TypeScript tooling experiments",
  "engines": {
    "node": ">=24.11",
    "npm": ">=11.10"
  },
  "workspaces": [
    "packages/content-mapper",
    "packages/build",
    "packages/prettier-plugin",
    "packages/vscode"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present && tsc -p e2e/tsconfig.json",
    "format": "concurrently --kill-others-on-fail --names biome,fts \"biome check --write\" \"npm run format:fts\"",
    "format:check": "concurrently --kill-others-on-fail --names biome,fts \"biome check\" \"npm run format:fts:check\"",
    "format:fts": "npm run build -w @ftslang/prettier-plugin && prettier --plugin @ftslang/prettier-plugin --write \"**/*.fts\"",
    "format:fts:check": "npm run build -w @ftslang/prettier-plugin && prettier --plugin @ftslang/prettier-plugin --check \"**/*.fts\"",
    "hooks:install": "git config set --local hook.fts-verify.command 'npm run verify:commit' && git config set --local --all hook.fts-verify.event pre-commit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "npm run test --workspaces --if-present",
    "test:consumer": "vitest run --config e2e/vitest.config.ts",
    "test:integration": "npm run test:integration --workspaces --if-present && npm run test:consumer",
    "verify": "concurrently --kill-others-on-fail --names checks,tests \"npm run verify:commit\" \"npm test && npm run build && npm run test:integration\"",
    "verify:commit": "concurrently --kill-others-on-fail --names format,lint,types \"npm run format:check\" \"npm run lint\" \"npm run check\""
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@jridgewell/trace-mapping": "0.3.31",
    "@types/node": "26.2.0",
    "concurrently": "10.0.7",
    "esbuild": "0.28.2",
    "oxlint": "1.78.0",
    "prettier": "3.9.10",
    "typescript": "7.1.0-beta",
    "vitest": "4.1.12"
  }
}
