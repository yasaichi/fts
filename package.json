{
  "name": "fts",
  "description": "Proposal-aware TypeScript tooling experiments",
  "version": "0.0.1",
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@jridgewell/trace-mapping": "0.3.31",
    "@types/node": "26.2.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "oxlint": "1.78.0",
    "prettier": "3.9.10",
    "typescript": "7.1.0-beta",
    "vitest": "4.1.12",
    "wireit": "0.15.0"
  },
  "engines": {
    "node": ">=24.11",
    "npm": ">=11.10"
  },
  "private": true,
  "scripts": {
    "build": "wireit",
    "check": "wireit",
    "format": "wireit",
    "format:check": "wireit",
    "format:fts": "wireit",
    "format:fts:check": "wireit",
    "hooks:install": "git config set --local hook.fts-verify.command 'npm run verify:commit' && git config set --local --all hook.fts-verify.event pre-commit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "wireit",
    "test:e2e": "wireit",
    "test:e2e:npm": "wireit",
    "test:e2e:vscode": "wireit",
    "test:integration": "wireit",
    "verify": "wireit",
    "verify:commit": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "./packages/build:build",
        "./packages/content-mapper:build",
        "./packages/prettier-plugin:build",
        "./packages/vscode:build"
      ]
    },
    "build:editor-tests": {
      "command": "esbuild e2e/vscode/index.ts e2e/vscode/installed-vsix.test.ts --bundle --packages=external --platform=node --target=node24 --format=cjs --external:vscode --outdir=e2e/dist --out-extension:.js=.cjs",
      "files": [
        "e2e/vscode/*.ts"
      ],
      "output": [
        "e2e/dist/**"
      ]
    },
    "check": {
      "command": "tsc -p e2e/tsconfig.json",
      "dependencies": [
        "./packages/build:check",
        "./packages/content-mapper:check",
        "./packages/prettier-plugin:check",
        "./packages/vscode:check"
      ]
    },
    "format": {
      "dependencies": [
        "format:biome",
        "format:fts"
      ]
    },
    "format:biome": {
      "command": "biome check --write"
    },
    "format:biome:check": {
      "command": "biome check"
    },
    "format:check": {
      "dependencies": [
        "format:biome:check",
        "format:fts:check"
      ]
    },
    "format:fts": {
      "command": "prettier --plugin @ftslang/prettier-plugin --write \"**/*.fts\"",
      "dependencies": [
        "./packages/prettier-plugin:build"
      ]
    },
    "format:fts:check": {
      "command": "prettier --plugin @ftslang/prettier-plugin --check \"**/*.fts\"",
      "dependencies": [
        "./packages/prettier-plugin:build"
      ]
    },
    "test": {
      "dependencies": [
        "./packages/build:test",
        "./packages/content-mapper:test",
        "./packages/prettier-plugin:test",
        "./packages/vscode:test"
      ]
    },
    "test:e2e": {
      "dependencies": [
        "test:e2e:npm",
        "test:e2e:vscode"
      ]
    },
    "test:e2e:npm": {
      "command": "vitest run --config e2e/vitest.config.ts",
      "dependencies": [
        "./packages/build:build",
        "./packages/content-mapper:build",
        "./packages/prettier-plugin:build"
      ]
    },
    "test:e2e:vscode": {
      "dependencies": [
        "./packages/vscode:test:e2e"
      ]
    },
    "test:integration": {
      "dependencies": [
        "./packages/content-mapper:test:integration"
      ]
    },
    "verify": {
      "dependencies": [
        "build",
        "test",
        "test:e2e",
        "test:integration",
        "verify:commit"
      ]
    },
    "verify:commit": {
      "dependencies": [
        "check",
        "format:check",
        "lint"
      ]
    }
  },
  "workspaces": [
    "packages/content-mapper",
    "packages/build",
    "packages/prettier-plugin",
    "packages/vscode"
  ]
}
