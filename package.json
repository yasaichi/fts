{
  "name": "fts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Proposal-aware TypeScript tooling experiments",
  "displayName": "Future TypeScript",
  "engines": {
    "node": ">=24.11",
    "npm": ">=11.10",
    "vscode": "^1.125.0"
  },
  "main": "./dist/extension.cjs",
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "future-typescript",
        "aliases": [
          "Future TypeScript",
          "fts"
        ],
        "extensions": [
          ".fts"
        ],
        "configuration": "./syntaxes/language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "future-typescript",
        "scopeName": "source.fts",
        "path": "./syntaxes/future-typescript.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --import=tsx --test test/*.test.ts",
    "verify": "npm run check && npm test && npm run build"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/plugin-proposal-pipeline-operator": "8.0.1",
    "@jridgewell/trace-mapping": "0.3.31",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.2.0",
    "@types/vscode": "1.125.0",
    "@volar/language-core": "2.4.28",
    "@volar/language-server": "2.4.28",
    "@volar/language-service": "2.4.28",
    "@volar/typescript": "2.4.28",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "volar-service-typescript": "0.0.71",
    "vscode-jsonrpc": "9.0.1",
    "vscode-languageclient": "10.1.0",
    "vscode-uri": "3.1.0"
  }
}
